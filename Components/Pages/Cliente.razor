@page "/cliente"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Clientes</h2>

        <button class="btn btn-primary"
                @onclick="AbrirModalNuevo">
            Nuevo Cliente
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @claseMensaje">
            @mensaje
        </div>
    }

    @if (cargando)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">Cargando clientes...</p>
        </div>
    }
    else if (clientes.Count == 0)
    {
        <div class="alert alert-info">
            No hay clientes registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>CUI</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha nacimiento</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var cliente in ClientesPaginados)
                    {
                        <tr>

                            <td>@cliente.Id_cliente</td>

                            <td>@cliente.cui</td>

                            <td>@cliente.nombres</td>

                            <td>@cliente.apellidos</td>

                            <td>@cliente.direccion</td>

                            <td>@cliente.telefono</td>

                            <td>
                                @cliente.fecha_nacimiento?.ToString("dd/MM/yyyy")
                            </td>

                            <td class="text-center">

                                <button class="btn btn-warning btn-sm me-2"
                                        @onclick="() => AbrirModalEditar(cliente)">
                                    Editar
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => AbrirModalEliminar(cliente)">
                                    Eliminar
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>


        @if (TotalPaginas > 1)
        {
            <nav class="mt-3">

                <ul class="pagination justify-content-center">

                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">

                        <button class="page-link"
                                @onclick="PaginaAnterior">
                            Anterior
                        </button>

                    </li>


                    @for (int i = 1; i <= TotalPaginas; i++)
                    {
                        int pagina = i;

                        <li class="page-item @(paginaActual == pagina ? "active" : "")">

                            <button class="page-link"
                                    @onclick="() => IrPagina(pagina)">
                                @pagina
                            </button>

                        </li>
                    }


                    <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">

                        <button class="page-link"
                                @onclick="PaginaSiguiente">
                            Siguiente
                        </button>

                    </li>

                </ul>

            </nav>
        }
    }

</div>


@* =========================================================
   MODAL NUEVO / EDITAR
   ========================================================= *@

@if (mostrarModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        @(modoEdicion ? "Editar Cliente" : "Nuevo Cliente")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                    </button>

                </div>


                <EditForm Model="clienteFormulario"
                          OnValidSubmit="GuardarCliente">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    CUI
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteFormulario.cui" />

                                <ValidationMessage For="@(() => clienteFormulario.cui)" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Nombres
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteFormulario.nombres" />

                                <ValidationMessage For="@(() => clienteFormulario.nombres)" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Apellidos
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteFormulario.apellidos" />

                                <ValidationMessage For="@(() => clienteFormulario.apellidos)" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Teléfono
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="clienteFormulario.telefono" />

                                <ValidationMessage For="@(() => clienteFormulario.telefono)" />

                            </div>


                            <div class="col-md-12">

                                <label class="form-label">
                                    Dirección
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteFormulario.direccion" />

                                <ValidationMessage For="@(() => clienteFormulario.direccion)" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Fecha de nacimiento
                                </label>

                                <InputDate class="form-control"
                                           @bind-Value="clienteFormulario.fecha_nacimiento" />

                                <ValidationMessage For="@(() => clienteFormulario.fecha_nacimiento)" />

                            </div>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>
                                    @(modoEdicion ? "Actualizar" : "Guardar")
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}


@* =========================================================
   MODAL ELIMINAR
   ========================================================= *@

@if (mostrarModalEliminar && clienteEliminar != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header bg-danger text-white">

                    <h5 class="modal-title">
                        Eliminar Cliente
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CerrarModalEliminar">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        ¿Está seguro de eliminar este cliente?
                    </p>

                    <p class="fw-bold mb-0">
                        @clienteEliminar.nombres
                        @clienteEliminar.apellidos
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CerrarModalEliminar">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            disabled="@eliminando"
                            @onclick="EliminarCliente">

                        @if (eliminando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span>Eliminar</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    // =====================================================
    // VARIABLES
    // =====================================================

    private List<ClienteDto> clientes = new();

    private ClienteFormulario clienteFormulario = new();

    private ClienteDto? clienteEliminar;

    private bool mostrarModal = false;

    private bool mostrarModalEliminar = false;

    private bool modoEdicion = false;

    private bool cargando = true;

    private bool guardando = false;

    private bool eliminando = false;

    private string mensaje = "";

    private string claseMensaje = "alert-success";


    // =====================================================
    // PAGINACIÓN
    // =====================================================

    private int paginaActual = 1;

    private int registrosPorPagina = 5;


    private int TotalPaginas =>
        (int)Math.Ceiling(
            clientes.Count / (double)registrosPorPagina
        );


    private IEnumerable<ClienteDto> ClientesPaginados =>
        clientes
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina);


    // =====================================================
    // CARGAR
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }


    private async Task CargarClientes()
    {
        try
        {
            cargando = true;

            clientes =
                await Http.GetFromJsonAsync<List<ClienteDto>>(
                    "api/Clientes"
                )
                ?? new List<ClienteDto>();


            if (paginaActual > TotalPaginas && TotalPaginas > 0)
            {
                paginaActual = TotalPaginas;
            }

            if (TotalPaginas == 0)
            {
                paginaActual = 1;
            }
        }
        catch (Exception ex)
        {
            MostrarError(
                "Error al cargar clientes: " + ex.Message
            );
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // NUEVO
    // =====================================================

    private void AbrirModalNuevo()
    {
        modoEdicion = false;

        clienteFormulario = new ClienteFormulario();

        mostrarModal = true;
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void AbrirModalEditar(ClienteDto cliente)
    {
        modoEdicion = true;

        clienteFormulario = new ClienteFormulario
        {
            Id_cliente = cliente.Id_cliente,
            cui = cliente.cui,
            nombres = cliente.nombres,
            apellidos = cliente.apellidos,
            direccion = cliente.direccion,
            telefono = cliente.telefono,
            fecha_nacimiento = cliente.fecha_nacimiento
        };

        mostrarModal = true;
    }


    // =====================================================
    // CERRAR MODAL
    // =====================================================

    private void CerrarModal()
    {
        mostrarModal = false;

        clienteFormulario = new ClienteFormulario();
    }


    // =====================================================
    // GUARDAR / ACTUALIZAR
    // =====================================================

    private async Task GuardarCliente()
    {
        try
        {
            guardando = true;


            var cliente = new ClienteDto
            {
                Id_cliente = clienteFormulario.Id_cliente,
                cui = clienteFormulario.cui,
                nombres = clienteFormulario.nombres,
                apellidos = clienteFormulario.apellidos,
                direccion = clienteFormulario.direccion,
                telefono = clienteFormulario.telefono,
                fecha_nacimiento = clienteFormulario.fecha_nacimiento
            };


            if (modoEdicion)
            {
                var respuesta =
                    await Http.PutAsJsonAsync(
                        $"api/Clientes/{cliente.Id_cliente}",
                        cliente
                    );


                if (!respuesta.IsSuccessStatusCode)
                {
                    MostrarError(
                        "No se pudo actualizar el cliente."
                    );

                    return;
                }


                mensaje =
                    "Cliente actualizado correctamente.";

                claseMensaje =
                    "alert-success";
            }
            else
            {
                var respuesta =
                    await Http.PostAsJsonAsync(
                        "api/Clientes",
                        cliente
                    );


                if (!respuesta.IsSuccessStatusCode)
                {
                    MostrarError(
                        "No se pudo registrar el cliente."
                    );

                    return;
                }


                mensaje =
                    "Cliente registrado correctamente.";

                claseMensaje =
                    "alert-success";
            }


            mostrarModal = false;

            await CargarClientes();
        }
        catch (Exception ex)
        {
            MostrarError(
                "Error al guardar: " + ex.Message
            );
        }
        finally
        {
            guardando = false;
        }
    }


    // =====================================================
    // ELIMINAR
    // =====================================================

    private void AbrirModalEliminar(ClienteDto cliente)
    {
        clienteEliminar = cliente;

        mostrarModalEliminar = true;
    }


    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;

        clienteEliminar = null;
    }


    private async Task EliminarCliente()
    {
        if (clienteEliminar == null)
        {
            return;
        }


        try
        {
            eliminando = true;


            var respuesta =
                await Http.DeleteAsync(
                    $"api/Clientes/{clienteEliminar.Id_cliente}"
                );


            if (!respuesta.IsSuccessStatusCode)
            {
                MostrarError(
                    "No se pudo eliminar el cliente."
                );

                return;
            }


            mensaje =
                "Cliente eliminado correctamente.";

            claseMensaje =
                "alert-success";


            mostrarModalEliminar = false;

            clienteEliminar = null;


            await CargarClientes();
        }
        catch (Exception ex)
        {
            MostrarError(
                "Error al eliminar: " + ex.Message
            );
        }
        finally
        {
            eliminando = false;
        }
    }


    // =====================================================
    // PAGINACIÓN
    // =====================================================

    private void IrPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalPaginas)
        {
            paginaActual = pagina;
        }
    }


    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }


    private void PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
        }
    }


    // =====================================================
    // MENSAJES
    // =====================================================

    private void MostrarError(string texto)
    {
        mensaje = texto;

        claseMensaje = "alert-danger";
    }


    // =====================================================
    // DTO DEL API
    // =====================================================

    public class ClienteDto
    {
        public int Id_cliente { get; set; }

        public string? cui { get; set; }

        public string? nombres { get; set; }

        public string? apellidos { get; set; }

        public string? direccion { get; set; }

        public int? telefono { get; set; }

        public DateTime? fecha_nacimiento { get; set; }
    }


    // =====================================================
    // MODELO FORMULARIO
    // =====================================================

    public class ClienteFormulario
    {
        public int Id_cliente { get; set; }


        [Required(
            ErrorMessage = "El CUI es obligatorio."
        )]
        public string? cui { get; set; }


        [Required(
            ErrorMessage = "Los nombres son obligatorios."
        )]
        public string? nombres { get; set; }


        [Required(
            ErrorMessage = "Los apellidos son obligatorios."
        )]
        public string? apellidos { get; set; }


        [Required(
            ErrorMessage = "La dirección es obligatoria."
        )]
        public string? direccion { get; set; }


        [Required(
            ErrorMessage = "El teléfono es obligatorio."
        )]
        [Range(
            10000000,
            99999999,
            ErrorMessage = "El teléfono debe tener 8 dígitos."
        )]
        public int? telefono { get; set; }


        [Required(
            ErrorMessage = "La fecha de nacimiento es obligatoria."
        )]
        public DateTime? fecha_nacimiento { get; set; }
    }
}